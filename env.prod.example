# Settings for docker-compose.prod.yml. Copy to .env.prod and fill in your own values.
# NEVER commit .env.prod (it is git-ignored). Use: docker compose --env-file .env.prod -f docker-compose.prod.yml ...

# REQUIRED. Use hex only (letters a-f and digits) so it is safe inside the database URL.
# Generate each with:  openssl rand -hex 24
POSTGRES_PASSWORD=
# REQUIRED, at least 32 characters. Generate with:  openssl rand -hex 32
JWT_SECRET=

# Optional (defaults shown)
# POSTGRES_USER=taskflow
# POSTGRES_DB=taskflow
# JWT_TTL_MINUTES=60
# TRASH_RETENTION_DAYS=30
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# REGISTER_RATE_LIMIT_PER_MINUTE=5

# Which version of the images to run (a commit id or version tag); "dev" = the ones built locally.
# IMAGE_TAG=dev

# Where the web port is opened. 127.0.0.1 = this machine only (put your HTTPS proxy in front).
# Use 0.0.0.0 only if nothing else sits in front. See docs/deployment.md.
# WEB_BIND=127.0.0.1
# WEB_PORT=8088

# Proxies whose X-Forwarded-For header the API believes. The default is exactly the "web" container
# (fixed address in docker-compose.prod.yml). Keep it that narrow: see docs/deployment.md.
# TRUSTED_PROXIES=172.31.250.10
