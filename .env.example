# Copy to .env and edit. NEVER commit .env.
# These are local development values only.

# Backend
PORT=8080
DATABASE_URL=postgres://taskflow:taskflow_dev@localhost:5432/taskflow?sslmode=disable
# REQUIRED, at least 32 characters. Generate your own with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRASH_RETENTION_DAYS=30

# Postgres container
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_dev
POSTGRES_DB=taskflow

# Sign-in / sign-up limits per client address per minute. Keep the defaults in production;
# raise them only for automated tests, where many test users share one address.
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# REGISTER_RATE_LIMIT_PER_MINUTE=5
